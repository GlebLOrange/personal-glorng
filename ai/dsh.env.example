# Copy beside your DSH checkout (not committed with secrets).
# DSH reads provider keys from the environment — never commit real values.

DEEPSEEK_API_KEY=
# Repo this harness develops:
GLORNG_REPO_ROOT=/path/to/personal-glorng
# Same cwd Gortex indexes (see .cursor/mcp.json):
GORTEX_CWD=/path/to/personal-glorng
