# Host dev (`make dev-lite` + `make dev-lite-client`). Open http://localhost (nginx) or :3000 (Vite).
# Docker client (`make dev`) overrides via compose.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_BEHIND_NGINX=true
# Runtime Sentry off in Vite DEV unless explicitly enabled (also needs a DSN).
VITE_SENTRY_ENABLED=false
# VITE_CLIENT_SENTRY_DSN=
