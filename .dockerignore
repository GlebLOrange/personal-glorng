**/.git
node_modules
**/node_modules
.venv
**/.venv
server/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage
**/htmlcov
**/dist
**/build
**/coverage
**/playwright-report
**/test-results
.docker-cache
.worktrees
server/media
backups
logs
**/*.log
**/.DS_Store
